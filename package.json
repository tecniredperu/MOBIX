{
  "name": "mobix",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && npm run db:bootstrap && next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "uat:staging": "tsx scripts/uat-staging.ts",
    "verify": "npm run db:validate && npm run test && npm run typecheck && npm run build",
    "audit:prod": "node scripts/audit-production.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:bootstrap": "tsx prisma/bootstrap.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@hookform/resolvers": "^5.2.2",
    "dotenv": "^16.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "pg": "^8.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.0"
  }
}
