DATABASE_URL="postgresql://mobix:mobix@localhost:5433/mobix?schema=public"

# Producción: usa un valor aleatorio de al menos 32 caracteres.
AUTH_SECRET=""

# Solo se usa para habilitar el primer acceso de un usuario legado/sin contraseña.
# Después del primer ingreso MOBIX guarda un hash scrypt y deja de depender de esta clave.
MOBIX_BOOTSTRAP_PASSWORD=""

# Habilita cabeceras X-Forwarded-For / X-Real-IP únicamente si el proxy/CDN
# de producción las sobrescribe de forma confiable.
TRUST_PROXY_HEADERS="false"

# Protege los detalles internos de /api/health.
# En producción se recomienda configurarlo con 24 caracteres o más.
HEALTH_DETAILS_TOKEN=""

# Directorio para npm run db:backup.
MOBIX_BACKUP_DIR="backups"

# Opcional. Si se define, el backup elimina dumps locales más antiguos.
# La retención del proveedor de PostgreSQL debe configurarse por separado.
MOBIX_BACKUP_RETENTION_DAYS="30"

# Verificación del dominio final con npm run go-live:check.
MOBIX_BASE_URL=""
MOBIX_EXPECTED_COMMIT=""
MOBIX_MAX_HEALTH_MS="1500"
