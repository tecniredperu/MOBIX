# MOBIX · Reverse proxy HTTPS de referencia.
# Reemplaza mobix.example.com y las rutas del certificado antes de habilitarlo.
# Si usas el proxy administrado por Hostinger, replica estos encabezados allí.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream mobix_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name mobix.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mobix.example.com;

    ssl_certificate     /etc/letsencrypt/live/mobix.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mobix.example.com/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_http_version 1.1;
        proxy_pass http://mobix_app;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;

        # Importante: sobrescribe estos encabezados; no confíes en valores enviados por el cliente.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
